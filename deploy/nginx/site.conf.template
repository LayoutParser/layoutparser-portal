# Template de vhost Nginx (produção/self-host Linux), equivalente ao public/web.config do IIS.
# Placeholders (__PUBLIC_HOST__, __DEPLOY_ROOT__, __BFF_PORT__, __SSL_CERT_PATH__,
# __SSL_CERT_KEY_PATH__) são substituídos por scripts/deploy-linux.sh antes de copiar para
# /etc/nginx/sites-available/<SITE_NAME>.conf (com symlink em sites-enabled/). Não editar
# manualmente o arquivo gerado — ajuste este template e rode o deploy novamente.
#
# Certificado: self-signed gerado localmente no host (openssl). Geração e renovação manual
# (com reload do Nginx): ver deploy/README-tls.md.

server {
    listen 443 ssl http2;
    server_name __PUBLIC_HOST__;

    # Certificado self-signed do host (ex.: /etc/ssl/layoutparser/) — ver deploy/README-tls.md.
    ssl_certificate     __SSL_CERT_PATH__;
    ssl_certificate_key __SSL_CERT_KEY_PATH__;

    # TLS hardening explícito (não depende só da config global do Nginx).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    client_max_body_size 32m; # equivalente a maxAllowedContentLength=33554432

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;

    root __DEPLOY_ROOT__/current;
    index index.html;

    location = /health { return 404; }

    # Zera headers de trust vindos do cliente para impedir spoofing — o fluxo real de
    # autenticação é o OIDC nativo do BFF (/auth/login, /auth/callback), não o trust de header.
    location /auth/ {
        proxy_pass http://127.0.0.1:__BFF_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Iis-User "";
        proxy_set_header X-Iis-Roles "";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:__BFF_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Iis-User "";
        proxy_set_header X-Iis-Roles "";
        client_max_body_size 32m;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}

server {
    listen 80;
    server_name __PUBLIC_HOST__;
    return 301 https://$host$request_uri;
}
