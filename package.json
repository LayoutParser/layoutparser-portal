{
  "name": "layout-parser-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names FRONT,BFF --prefix-colors cyan,magenta \"npm:dev:front\" \"npm:dev:bff\"",
    "dev:front": "vite",
    "dev:bff": "cross-env NODE_ENV=development BFF_DEV_AUTH_ENABLED=true BFF_ADMIN_USERS=layoutparser.local npm --prefix server run dev",
    "build": "tsc && vite build",
    "build:all": "npm run build && npm --prefix server run build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fixture:mqseries": "tsc -p tsconfig.real-fixture.json --noEmit && vitest run --config vitest.real-fixture.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:real": "tsc -p tsconfig.e2e.json --noEmit && playwright test --config playwright.real.config.ts",
    "contract:check": "node scripts/check-api-contract.mjs",
    "artifacts:validate": "node scripts/validate-production-artifacts.mjs",
    "audit": "npm audit --audit-level=moderate",
    "quality:front": "npm run lint && npm run typecheck && npm run test:coverage && npm run build:dev && npm run build:prod && npm run artifacts:validate && npm run format:check && npm run audit",
    "quality:server": "npm --prefix server run quality",
    "quality": "npm run quality:front && npm run quality:server && npm run typecheck:e2e && npm run contract:check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "30.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "msw@2.15.0": true
  }
}
