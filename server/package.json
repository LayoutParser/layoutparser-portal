{
  "name": "@layout-parser/academic-bff",
  "version": "1.0.0",
  "private": true,
  "description": "BFF acadêmico e seguro para o front-end LayoutParser.",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=moderate",
    "quality": "npm run typecheck && npm run test:coverage && npm run build && npm run audit"
  },
  "dependencies": {
    "@azure/msal-node": "5.5.0",
    "@fastify/busboy": "3.2.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/http-proxy": "11.6.3",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/secure-session": "8.4.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
